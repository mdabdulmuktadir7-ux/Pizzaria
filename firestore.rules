rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status', 'createdAt', 'paymentMethod', 'deliveryDetails']) 
             && data.keys().size() == 7
             && data.userId is string && data.userId == request.auth.uid
             && data.items is list && data.items.size() > 0 && data.items.size() <= 100
             && data.total is number 
             && data.status is string && data.status.size() <= 50
             && data.paymentMethod is string && data.paymentMethod.size() <= 50
             && data.deliveryDetails is map;
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() 
                    && isValidId(orderId) 
                    && isValidOrder(incoming())
                    && incoming().createdAt == request.time;
      allow update: if false; 
      allow delete: if false; 
    }
  }
}
